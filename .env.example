# ---- Database (pgvector) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dra
POSTGRES_PASSWORD=dra
POSTGRES_DB=dra

# ---- LLM routing (LiteLLM) ----
# Chat model used for planning + synthesis.
# Local (free) example:  ollama/llama3.2
# Cloud example:         openai/gpt-4o-mini, anthropic/claude-3-5-haiku-latest
LITELLM_MODEL_CHAT=ollama/llama3.2

# Optional fallback model to demonstrate multi-provider failover routing.
# LITELLM_MODEL_CHAT_FALLBACK=openai/gpt-4o-mini

# Embedding model. Local (free) example: ollama/nomic-embed-text
LITELLM_MODEL_EMBED=ollama/nomic-embed-text
EMBEDDING_DIM=768

# Provider keys (only needed if you route to cloud models)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...

# ---- Cost cap (optional, AD-15) ----
# Hard per-run spend cap in USD. Unset = uncapped; the free Ollama path never
# trips a cap. An unparseable value logs a startup warning and runs uncapped.
# Per-run override: the research_jobs.cost_cap_usd column wins over this env.
# Suggested starting range for paid-model runs: $0.50-$5.00 (see README).
# RUN_COST_CAP_USD=2.00

# ---- Observability (Langfuse via OpenTelemetry OTLP, optional) ----
# Set both keys to export spans (plan -> research -> synthesise) with token
# usage and cost to Langfuse. Without keys, OTel no-ops — free local stack.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=5
# Whether to also query the Azure AI Search Free tier (optional Azure touchpoint).
AZURE_SEARCH_ENABLED=false
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_KEY=
AZURE_SEARCH_INDEX=deep-research
